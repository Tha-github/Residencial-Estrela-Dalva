---
/**
 * Página inicial — conteúdo real (src/data/residencial.json).
 *
 * Trava de lançamento: em PUBLIC_DEPLOY_ENV=production o build falha se algum
 * dado obrigatório (fotos, links do Booking.com e do Airbnb...) ainda estiver
 * pendente. Para revisar com o cliente antes disso, use PUBLIC_DEPLOY_ENV=preview.
 */
import { PUBLIC_DEPLOY_ENV } from 'astro:env/client';
import HomePage from '../components/HomePage.astro';
import { getContent } from '../lib/content/load';
import { assertReadyForLaunch } from '../lib/content/pending';

const content = getContent();
if (PUBLIC_DEPLOY_ENV === 'production') assertReadyForLaunch(content);

const { location, property, practical, distances } = content;
const beach = distances.find((d) => d.kind === 'praia');
const title = `${content.name} | ${property.type} nos ${location.neighborhood}, ${location.city}`;
const description = [
  `${property.type} com mezanino nos ${location.neighborhood}, em ${location.city} (${location.stateCode})`,
  practical.maxGuests ? `para até ${practical.maxGuests} pessoas` : null,
  beach ? `a ${beach.meters} m da ${beach.place}` : null,
]
  .filter(Boolean)
  .join(', ')
  .concat('. Cozinha completa e área externa com churrasqueira.');
---

<HomePage
  content={content}
  pageTitle={title}
  description={description}
  clientPreview={PUBLIC_DEPLOY_ENV === 'preview'}
/>
