---
import { Font } from 'astro:assets';
import { PUBLIC_DEPLOY_ENV } from 'astro:env/client';
import { getContent } from '../lib/content/load';
import { themeTokens } from '../lib/theme';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  socialImage?: string;
  /** Força noindex (ex.: 404). Fora de produção o site inteiro já é noindex. */
  noindex?: boolean;
}

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { title, description, socialImage = `${baseUrl}og-residencial.png`, noindex = false } = Astro.props;
const isProduction = PUBLIC_DEPLOY_ENV === 'production';
const themeStyle = Object.entries(themeTokens(getContent().theme)).map(([key, value]) => `${key}:${value}`).join(';');
const robots = !isProduction || noindex ? 'noindex, nofollow' : undefined;
const basePath = baseUrl === '/' ? '' : baseUrl.replace(/\/$/, '');
const routePath = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname;
const canonical = Astro.site && isProduction && !noindex
  ? new URL(`${baseUrl}${routePath.replace(/^\/+/, '')}`, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="pt-BR" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    {canonical && !noindex && description && <meta property="og:type" content="website" />}
    {canonical && !noindex && description && <meta property="og:locale" content="pt_BR" />}
    {canonical && !noindex && description && <meta property="og:site_name" content="Residencial Estrela Dalva" />}
    {canonical && !noindex && description && <meta property="og:title" content={title} />}
    {canonical && !noindex && description && <meta property="og:description" content={description} />}
    {canonical && !noindex && description && <meta property="og:url" content={canonical} />}
    {canonical && !noindex && description && <meta property="og:image" content={new URL(socialImage, Astro.site).href} />}
    {canonical && !noindex && description && <meta property="og:image:width" content="1200" />}
    {canonical && !noindex && description && <meta property="og:image:height" content="630" />}
    {canonical && !noindex && description && <meta property="og:image:alt" content="Residencial Estrela Dalva, loft com mezanino nos Ingleses, Florianópolis" />}
    {canonical && !noindex && description && <meta name="twitter:card" content="summary_large_image" />}
    {canonical && !noindex && description && <meta name="twitter:title" content={title} />}
    {canonical && !noindex && description && <meta name="twitter:description" content={description} />}
    {canonical && !noindex && description && <meta name="twitter:image" content={new URL(socialImage, Astro.site).href} />}
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="theme-color" content="#0b3346" />
    <meta name="generator" content={Astro.generator} />
    {/* Preload do que aparece acima da dobra: o título do banner usa display normal E itálico
        (sem o itálico, a troca de fonte reflui o título e gera CLS no mobile). */}
    <Font cssVariable="--font-display" preload={[{ weight: 400, style: 'normal' }, { style: 'italic' }]} />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot name="header" />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
