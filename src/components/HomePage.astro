---
/**
 * Composição da página inicial a partir do conteúdo validado.
 * Usada por pages/index.astro (conteúdo real) e pela prévia de desenvolvimento
 * (dev-pages/previa-completa.astro, com dados de exemplo rotulados).
 *
 * Ordem (pensada para um loft): banner → informações rápidas → o loft →
 * fotos → acomodação → comodidades → localização → experiência →
 * informações práticas → reservas → dúvidas.
 * Seção sem dado confirmado não é renderizada; na prévia do cliente, os
 * espaços pendentes aparecem como quadros tracejados (nunca links falsos).
 */
import Footer from './layout/Footer.astro';
import Header from './layout/Header.astro';
import MobileBookingBar from './layout/MobileBookingBar.astro';
import AmenitiesSection from './sections/AmenitiesSection.astro';
import BookingSection from './sections/BookingSection.astro';
import ExperienceSection from './sections/ExperienceSection.astro';
import FaqSection from './sections/FaqSection.astro';
import GallerySection from './sections/GallerySection.astro';
import Hero from './sections/Hero.astro';
import LocationSection from './sections/LocationSection.astro';
import LoftSection from './sections/LoftSection.astro';
import PracticalSection from './sections/PracticalSection.astro';
import QuickFacts from './sections/QuickFacts.astro';
import SleepingSection from './sections/SleepingSection.astro';
import PendingContent from './dev/PendingContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFaq,
  getHeroHighlights,
  getNavItems,
  getPlatformSlots,
  getSectionTones,
  getVisibility,
  SECTION_IDS,
} from '../lib/content/derive';
import { getPendingItems } from '../lib/content/pending';
import type { Residencial } from '../lib/content/schema';

interface Props {
  content: Residencial;
  /** Título da aba (a prévia de dev usa um título próprio). */
  pageTitle?: string;
  description?: string;
  noindex?: boolean;
  clientPreview?: boolean;
}

const { content, pageTitle, description, noindex = false, clientPreview = false } = Astro.props;
const visible = getVisibility(content);
// Na prévia do cliente, galeria aparece mesmo vazia (com quadros indicando as fotos).
const loftPhotos = content.gallery.filter((image) => image.group !== 'regiao');
const display = { ...visible, gallery: loftPhotos.length > 0 || clientPreview, booking: visible.booking || clientPreview };
const tone = getSectionTones(display);
const toneOf = (key: keyof typeof tone) => (tone[key] === 'inverse' ? 'default' : tone[key]);
const nav = getNavItems(display);
const { hero } = content;
const faq = getFaq(content);

const targetHref: Record<'booking' | 'loft' | 'gallery' | 'location', string> = {
  booking: `#${SECTION_IDS.booking}`,
  loft: `#${SECTION_IDS.loft}`,
  gallery: `#${SECTION_IDS.gallery}`,
  location: `#${SECTION_IDS.location}`,
};
const bookingHref = `#${SECTION_IDS.booking}`;
const heroCta = display.booking ? { href: targetHref[hero.primaryTarget], label: hero.primaryLabel } : null;
const heroSecondary = display.loft ? { href: targetHref[hero.secondaryTarget], label: hero.secondaryLabel } : null;
---

<BaseLayout title={pageTitle ?? content.name} description={description} noindex={noindex}>
  <Header slot="header" name={content.name} nav={nav} cta={display.booking ? { href: bookingHref, label: 'Reservar' } : null} />

  <Hero
    name={content.name}
    title={hero.title}
    subtitle={hero.subtitle}
    image={hero.image}
    highlights={getHeroHighlights(content)}
    cta={heroCta}
    secondaryCta={heroSecondary}
    clientPreview={clientPreview}
  />
  <QuickFacts content={content} />

  {display.loft && <LoftSection content={content} tone={toneOf('loft')} clientPreview={clientPreview} />}
  {display.gallery && <GallerySection images={loftPhotos} title={content.copy.galleryTitle} tone={toneOf('gallery')} clientPreview={clientPreview} />}
  {display.sleeping && <SleepingSection content={content} tone={toneOf('sleeping')} />}
  {display.amenities && <AmenitiesSection amenities={content.amenities} copy={content.copy} tone={toneOf('amenities')} />}
  {display.location && <LocationSection content={content} tone={toneOf('location')} clientPreview={clientPreview} />}
  {display.experience && <ExperienceSection content={content} clientPreview={clientPreview} />}
  {display.practical && <PracticalSection content={content} title={content.copy.practicalTitle} tone={toneOf('practical')} />}
  {
    display.booking && (
      <BookingSection
        content={content}
        platforms={getPlatformSlots(content, clientPreview)}
        tone={toneOf('booking')}
      />
    )
  }
  {display.faq && <FaqSection items={faq} contact={content.contact} title={content.copy.faqTitle} tone={toneOf('faq')} />}

  {!clientPreview && <PendingContent items={getPendingItems(content)} />}

  <Footer slot="footer" content={content} nav={nav} platforms={getPlatformSlots(content, clientPreview)} />
  {display.booking && <MobileBookingBar slot="footer" />}
</BaseLayout>

