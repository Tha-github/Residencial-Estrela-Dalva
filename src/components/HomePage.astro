---
/**
 * Composição da página inicial a partir do conteúdo validado.
 * Usada por pages/index.astro (conteúdo real) e pela prévia de desenvolvimento
 * (pages/dev/[page].astro, com dados de exemplo rotulados).
 *
 * Ordem: hero → apresentação → fotos → diferenciais → informações →
 * localização → reservas → contato. Seção sem dado confirmado não é renderizada.
 */
import Footer from './layout/Footer.astro';
import Header from './layout/Header.astro';
import MobileBookingBar from './layout/MobileBookingBar.astro';
import AboutSection from './sections/AboutSection.astro';
import BookingSection from './sections/BookingSection.astro';
import ContactSection from './sections/ContactSection.astro';
import GallerySection from './sections/GallerySection.astro';
import Hero from './sections/Hero.astro';
import HighlightsSection from './sections/HighlightsSection.astro';
import LocationSection from './sections/LocationSection.astro';
import PracticalSection from './sections/PracticalSection.astro';
import PendingContent from './dev/PendingContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBookingPlatforms, getNavItems, getSectionTones, getVisibility, SECTION_IDS } from '../lib/content/derive';
import { getPendingItems } from '../lib/content/pending';
import type { Residencial } from '../lib/content/schema';

interface Props {
  content: Residencial;
  /** Título da aba (a prévia de dev usa um título próprio). */
  pageTitle?: string;
  description?: string;
  noindex?: boolean;
  clientPreview?: boolean;
}

const { content, pageTitle, description, noindex = false, clientPreview = false } = Astro.props;
const visible = getVisibility(content);
const display = Object.fromEntries(Object.entries(visible).map(([key, value]) => [key, value || clientPreview])) as typeof visible;
const tone = getSectionTones(display);
const platforms = getBookingPlatforms(content);
const nav = getNavItems(display);
const { location, hero } = content;
const locationLabel = `${location.beach} · ${location.city}, ${location.stateCode}`;

const bookingHref = `#${SECTION_IDS.booking}`;
const heroCta = visible.booking || clientPreview ? { href: bookingHref, label: 'Ver opções de reserva' } : null;
const heroSecondary = visible.about ? { href: `#${SECTION_IDS.about}`, label: 'Conhecer o residencial' } : null;
---

<BaseLayout title={pageTitle ?? content.name} description={description} noindex={noindex}>
  <Header slot="header" name={content.name} nav={nav} cta={visible.booking || clientPreview ? { href: bookingHref, label: clientPreview && !visible.booking ? 'Opções de reserva' : 'Reservar' } : null} />

  {clientPreview && (
    <div class="client-preview-banner" role="status">
      Prévia para revisão: os quadros tracejados mostram onde entram fotos e informações ainda pendentes.
    </div>
  )}

  <Hero
    name={content.name}
    locationLabel={locationLabel}
    title={hero.title}
    subtitle={hero.subtitle}
    image={hero.image}
    cta={heroCta}
    secondaryCta={heroSecondary}
    clientPreview={clientPreview}
  />

  {display.about && <AboutSection content={content} tone={tone.about} />}
  {display.gallery && <GallerySection images={content.gallery} tone={tone.gallery} clientPreview={clientPreview} />}
  {display.highlights && <HighlightsSection highlights={content.highlights} tone={tone.highlights} />}
  {display.practical && <PracticalSection content={content} tone={tone.practical} clientPreview={clientPreview} />}
  {display.location && <LocationSection location={location} tone={tone.location} clientPreview={clientPreview} />}
  {display.booking && <BookingSection name={content.name} platforms={platforms} tone={tone.booking} clientPreview={clientPreview} />}
  {display.contact && <ContactSection contact={content.contact} tone={tone.contact} clientPreview={clientPreview} />}

  {!clientPreview && <PendingContent items={getPendingItems(content)} />}

  <Footer slot="footer" content={content} nav={nav} platforms={platforms} />
  {visible.booking && <MobileBookingBar slot="footer" />}
</BaseLayout>

<style>
  .client-preview-banner {
    padding: var(--space-3) var(--gutter);
    background: var(--color-accent-soft);
    color: var(--color-heading);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
