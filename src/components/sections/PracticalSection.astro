---
/**
 * Informações práticas: horários, capacidade e canais de contato direto.
 * Só dados confirmados; regras da casa aparecem apenas se informadas.
 */
import { formatTime, formatWhatsapp, mailtoUrl, SECTION_IDS, whatsappUrl } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Icon, { type IconName } from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  content: Residencial;
  tone: 'default' | 'alt';
}

const { content, tone } = Astro.props;
const { practical: p, contact } = content;

const tiles: Array<{ icon: IconName; label: string; value: string; note: string }> = [];
if (p.checkIn) tiles.push({ icon: 'log-in', label: 'Check-in', value: formatTime(p.checkIn), note: 'a partir das' });
if (p.checkOut) tiles.push({ icon: 'log-out', label: 'Check-out', value: formatTime(p.checkOut), note: 'até as' });
if (p.maxGuests) tiles.push({ icon: 'users', label: 'Capacidade', value: String(p.maxGuests), note: p.maxGuests === 1 ? 'pessoa' : 'pessoas, no máximo' });
const hasDirect = Boolean(contact.whatsapp || contact.email);
const emailSubject = `Hospedagem no ${content.name}`;
---

<Section id={SECTION_IDS.practical} eyebrow="Informações práticas" title="Bom saber *antes de chegar*" tone={tone}>
  <ul class="info" role="list">
    {
      tiles.map((t) => (
        <li class="tile reveal">
          <p class="tile__label">
            <Icon name={t.icon} size={18} />
            {t.label}
          </p>
          <p class="tile__value">
            <span class="tile__note">{t.note}</span>
            <span class="numeral">{t.value}</span>
          </p>
        </li>
      ))
    }
    {
      hasDirect && (
        <li class="tile tile--contact reveal">
          <p class="tile__label">
            <Icon name="message" size={18} />
            Reserva direta
          </p>
          <p class="tile__lead">Disponível por WhatsApp e e-mail, diretamente com o proprietário.</p>
          <ul class="tile__links" role="list">
            {contact.whatsapp && (
              <li>
                <a href={whatsappUrl(contact.whatsapp, contact.whatsappMessage)} target="_blank" rel="noopener noreferrer">
                  WhatsApp {formatWhatsapp(contact.whatsapp)}
                  <span class="visually-hidden">(abre em nova aba)</span>
                </a>
              </li>
            )}
            {contact.email && (
              <li>
                <a href={mailtoUrl(contact.email, emailSubject)}>{contact.email}</a>
              </li>
            )}
          </ul>
        </li>
      )
    }
  </ul>

  {
    p.rules.length > 0 && (
      <div class="rules reveal">
        <h3 class="rules__title">Regras da casa</h3>
        <ul role="list">
          {p.rules.map((r) => (
            <li>
              <Icon name="check" size={16} />
              {r}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>

<style>
  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .info {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.6fr);
    }
  }

  .tile {
    display: grid;
    align-content: space-between;
    gap: var(--space-5);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .tile p {
    margin: 0;
  }

  .tile__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .tile__value {
    display: grid;
  }

  .tile__value .numeral {
    font-size: clamp(3rem, 2.2rem + 3vw, 4.25rem);
    color: var(--color-title);
  }

  .tile__note {
    font-family: var(--font-display-stack);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .tile--contact {
    align-content: start;
    gap: var(--space-3);
    background: var(--color-accent-soft);
    border-color: transparent;
  }

  .tile__lead {
    color: var(--color-heading);
  }

  .tile__links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--font-weight-bold);
    overflow-wrap: anywhere;
  }

  .rules {
    margin-top: var(--space-7);
  }

  .rules ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rules li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
</style>
