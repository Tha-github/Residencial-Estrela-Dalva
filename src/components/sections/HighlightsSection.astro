---
/** Diferenciais confirmados (vêm do conteúdo; nada é fixo no componente). */
import { SECTION_IDS } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';

interface Props {
  highlights: Residencial['highlights'];
  tone?: 'default' | 'alt';
}

const { highlights, tone } = Astro.props;
---

<Section id={SECTION_IDS.highlights} eyebrow="Diferenciais" title="Por que se hospedar aqui" tone={tone}>
  <ul class="highlights" role="list">
    {
      highlights.map((h) => (
        <Card as="li" title={h.title} icon={h.icon ?? undefined} class="reveal">
          <p>{h.text}</p>
        </Card>
      ))
    }
  </ul>
</Section>

<style>
  .highlights {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .highlights {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
</style>
