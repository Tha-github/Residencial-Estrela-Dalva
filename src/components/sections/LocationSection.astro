---
/**
 * Localização com link do Google Maps validado (sem iframe: mapa embutido é
 * pesado e carrega cookies de terceiros — um link leve resolve).
 */
import { SECTION_IDS } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PreviewPlaceholder from '../ui/PreviewPlaceholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  location: Residencial['location'];
  tone?: 'default' | 'alt';
  clientPreview?: boolean;
}

const { location, tone, clientPreview = false } = Astro.props;
---

<Section id={SECTION_IDS.location} eyebrow="Localização" title={`${location.beach}, ${location.city}`} tone={tone}>
  <div class="location">
    <div class="location__pin" aria-hidden="true">
      <Icon name="map-pin" size={28} />
    </div>
    <div>
      {location.address && <address class="location__address">{location.address}</address>}
      {clientPreview && !location.address && <p class="location__pending">Endereço completo a confirmar</p>}
      <p class="location__region">
        {location.beach} · {location.city}, {location.state}
      </p>
      {
        location.mapsUrl && (
          <Button href={location.mapsUrl} external variant="secondary">
            Abrir no Google Maps
          </Button>
        )
      }
      {clientPreview && !location.mapsUrl && <PreviewPlaceholder shape="inline" label="Link do Google Maps" />}
    </div>
  </div>
</Section>

<style>
  .location {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    max-width: var(--width-prose);
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .location__pin {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .location__address {
    margin-bottom: var(--space-2);
    font-style: normal;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-heading);
  }

  .location__pending {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .location__region {
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
  }

  @media (max-width: 479.98px) {
    .location {
      flex-direction: column;
      padding: var(--space-5);
    }
  }
</style>
