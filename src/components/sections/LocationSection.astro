---
/**
 * Localização: as duas distâncias informadas pelo proprietário.
 * - Régua proporcional: loft no zero e cada destino na sua distância. Mostra
 *   proximidade sem sugerir direção, rua ou coordenada (nenhuma foi confirmada).
 * - Um bloco por percurso, com o que há por perto.
 * - Link do Google Maps só quando informado (sem mapa embutido: mais leve e
 *   sem cookies de terceiros; a CSP também não permite iframes).
 */
import { joinList, photoOf, SECTION_IDS } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import PreviewPlaceholder from '../ui/PreviewPlaceholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  content: Residencial;
  tone: 'default' | 'alt';
  clientPreview?: boolean;
}

const { content, tone, clientPreview = false } = Astro.props;
const { location, distances, property } = content;
const sorted = [...distances].sort((a, b) => a.meters - b.meters);
const nearby = location.nearby.map((n, i) => (i === 0 ? n : n.toLowerCase()));
const regionPhoto = photoOf(content, 'regiao');
---

<Section
  align="center"
  id={SECTION_IDS.location}
  eyebrow={`${location.neighborhood} · ${location.city}, ${location.stateCode}`}
  title={content.copy.locationTitle}
  intro={content.copy.locationIntro}
  tone={tone}
>
  <div class="places">
    {
      sorted.map((d) => (
        <article class:list={['place', `place--${d.kind}`, 'reveal']}>
          <span class="place__icon">
            <Icon name={d.kind === 'praia' ? 'waves' : 'bag'} size={26} />
          </span>
          <p class="place__distance">
            <span class="numeral">{d.meters}</span>
            <span class="place__unit">metros</span>
          </p>
          <h3 class="place__name">{d.place}</h3>
          <p class="place__text">
            {d.kind === 'praia'
              ? `Aproximadamente ${d.meters} metros entre o ${property.type.toLowerCase()} e o mar.`
              : nearby.length > 0
                ? `Aproximadamente ${d.meters} metros. ${joinList(nearby)} por perto.`
                : `Aproximadamente ${d.meters} metros.`}
          </p>
        </article>
      ))
    }

    <div class="place place--aside reveal">
      {
        (regionPhoto || clientPreview) && (
          <PhotoSlot
            image={regionPhoto}
            pendingLabel="Praia dos Ingleses ou Centrinho (foto real da região)"
            clientPreview={clientPreview}
            sizes="(min-width: 1024px) 30vw, 90vw"
            ratio="4 / 3"
          />
        )
      }
      {location.address && <address class="place__address">{location.address}</address>}
      {
        location.mapsUrl ? (
          <Button href={location.mapsUrl} variant="secondary" external icon="map-pin">
            Ver localização no Google Maps
          </Button>
        ) : (
          clientPreview && (
            <PreviewPlaceholder label="Link do Google Maps do imóvel" shape="inline" />
          )
        )
      }
    </div>
  </div>
</Section>

<style>
  .places {
    display: grid;
    gap: var(--grid-gap);
  }

  @media (min-width: 768px) {
    .places {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .place--aside {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .places {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .place--aside {
      grid-column: auto;
    }
  }

  .place {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
  }

  .place--praia {
    border-color: transparent;
    background:
      radial-gradient(80% 70% at 100% 0%, rgb(227 162 124 / 0.25), transparent 70%),
      var(--sea-900);
    color: var(--sand-50);
  }

  .place--praia .numeral,
  .place--praia .place__name {
    color: var(--white);
  }

  .place--praia .place__text,
  .place--praia .place__unit {
    color: var(--sea-200);
  }

  .place--praia .place__icon {
    background: rgb(255 255 255 / 0.12);
    color: var(--terra-300);
  }

  .place--aside {
    padding: 0;
    border: 0;
    background: none;
    gap: var(--space-4);
  }

  .place__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .place__distance {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }

  .place__distance .numeral {
    font-size: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .place__unit {
    font-family: var(--font-display-stack);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .place__name {
    margin: 0;
    font-size: var(--text-xl);
  }

  .place__text {
    margin: 0;
    color: var(--color-text-muted);
  }

  .place__address {
    font-style: normal;
  }
</style>
