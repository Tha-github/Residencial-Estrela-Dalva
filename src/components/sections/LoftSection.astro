---
/**
 * Apresentação do loft: descrição, destaques confirmados e composição de
 * fotos que mostra os dois níveis (ambientes integrados abaixo, mezanino acima).
 * Fotos vêm dos grupos "integrado" e "mezanino" da galeria.
 */
import { photoOf, SECTION_IDS } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Icon from '../ui/Icon.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import Section from '../ui/Section.astro';

interface Props {
  content: Residencial;
  tone: 'default' | 'alt';
  clientPreview?: boolean;
}

const { content, tone, clientPreview = false } = Astro.props;
const { about, features, property, location } = content;
const lower = photoOf(content, 'integrado');
const upper = photoOf(content, 'mezanino');
const hasMedia = Boolean(lower || upper || clientPreview);
---

<Section
  align="center"
  id={SECTION_IDS.loft}
  eyebrow={`${property.type} · ${property.unit} · ${location.neighborhood}`}
  title={about.title ?? `Conheça o ${property.type.toLowerCase()}`}
  tone={tone}
>
  <div class:list={['loft', { 'loft--media': hasMedia }]}>
    <div class="loft__text reveal">
      {about.paragraphs.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}

      {
        features.length > 0 && (
          <ul class="loft__features" role="list">
            {features.map((f) => (
              <li class="feature">
                <span class="feature__icon">
                  <Icon name={f.icon} size={22} />
                </span>
                <div>
                  <h3 class="feature__title">{f.title}</h3>
                  {f.text && <p class="feature__text">{f.text}</p>}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      hasMedia && (
        <div class="loft__media reveal">
          <div class="loft__photo loft__photo--lower">
            <PhotoSlot
              image={lower}
              pendingLabel="Ambientes integrados do piso inferior"
              clientPreview={clientPreview}
              sizes="(min-width: 1024px) 40vw, 90vw"
              ratio="4 / 5"
            />
            <span class="loft__tag">Piso inferior</span>
          </div>
          <div class="loft__photo loft__photo--upper">
            <PhotoSlot
              image={upper}
              pendingLabel="Mezanino"
              clientPreview={clientPreview}
              sizes="(min-width: 1024px) 24vw, 55vw"
              ratio="1 / 1"
            />
            <span class="loft__tag">Mezanino</span>
          </div>
          <span class="loft__star" aria-hidden="true">
            <Icon name="star" size={28} />
          </span>
        </div>
      )
    }
  </div>
</Section>

<style>
  .loft {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .loft--media {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: var(--space-9);
    }
  }

  .loft__text > p {
    max-width: var(--width-prose);
  }

  .loft__features {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Sem fotos, os destaques ocupam a largura em colunas. */
  .loft:not(.loft--media) .loft__features {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .feature {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .feature__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .feature__title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .feature__text {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }

  /* Composição em dois níveis: a foto do mezanino "flutua" acima da do piso inferior. */
  .loft__media {
    position: relative;
    padding: 0 0 var(--space-8) 0;
  }

  .loft__photo {
    position: relative;
  }

  .loft__photo--lower {
    width: 82%;
    margin-left: auto;
  }

  .loft__photo--upper {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 48%;
    border: 6px solid var(--section-bg, var(--color-bg));
    border-radius: calc(var(--radius-lg) + 6px);
    box-shadow: var(--shadow-lg);
  }

  .loft__tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background: rgb(var(--sea-rgb) / 0.78);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .loft__star {
    position: absolute;
    top: -1.25rem;
    left: 8%;
    color: var(--color-highlight);
  }

  @media (max-width: 479.98px) {
    .loft__photo--lower {
      width: 90%;
    }
    .loft__photo--upper {
      width: 58%;
    }
  }
</style>
