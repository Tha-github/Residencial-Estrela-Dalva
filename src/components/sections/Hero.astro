---
/**
 * Banner principal.
 * Composição: navbar branca acima (Header), foto ampla em moldura arredondada,
 * formas geométricas translúcidas (vidro) sobre a foto e painel de vidro com
 * identificação, título, descrição, destaques e dois CTAs.
 *
 * - Com foto real: foto em toda a moldura + véu lateral (texto sempre legível;
 *   o painel tem opacidade suficiente para 4.5:1 mesmo sobre foto branca).
 * - Sem foto: fundo de mar profundo com o brilho da "estrela da manhã".
 *   Nunca uma foto genérica no lugar da real. Na prévia, um aviso diz qual
 *   foto enviar.
 */
import { Picture } from 'astro:assets';
import type { Image } from '../../lib/content/schema';
import { FORMATS, resolveImage, WIDTHS } from '../../lib/images';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  name: string;
  unitLabel: string;
  title: string | null;
  subtitle: string | null;
  image: Image | null;
  highlights: Array<{ icon: 'users' | 'waves' | 'bag'; text: string }>;
  cta: { href: string; label: string } | null;
  secondaryCta: { href: string; label: string } | null;
  clientPreview?: boolean;
}

const { name, unitLabel, title, subtitle, image, highlights, cta, secondaryCta, clientPreview = false } = Astro.props;
const heroFile = image ? resolveImage(image.src) : null;
const titleParts = (title ?? name).split(/\*(.+?)\*/);
---

<section class:list={['hero', image ? 'hero--photo' : 'hero--brand']} aria-labelledby="hero-titulo">
  <div class="hero__frame container container--wide">
    <div class="hero__stage">
      <div class="hero__media">
        {
          image && heroFile && (
            // Imagem LCP: sem lazy-load, prioridade alta.
            <Picture
              src={heroFile}
              alt={image.alt}
              formats={[...FORMATS]}
              widths={[...WIDTHS.hero]}
              sizes="(min-width: 1536px) 1472px, calc(100vw - 2rem)"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              style={`object-position: ${image.focus}`}
              class="hero__img"
            />
          )
        }
        <div class="hero__scrim"></div>
      </div>

      <!-- Formas geométricas translúcidas: profundidade, sem informação. -->
      <div class="hero__shapes" aria-hidden="true">
        <span class="shape shape--diamond"></span>
        <span class="shape shape--circle"></span>
        <span class="shape shape--bar"></span>
        <span class="shape shape--star"></span>
      </div>

      <div class="hero__panel">
        <p class="hero__eyebrow">
          <Icon name="star" size={12} class="hero__star" />
          <span>{name}</span>
        </p>
        <h1 id="hero-titulo" class="hero__title">
          {titleParts.map((part, i) => (i % 2 === 1 ? <em>{part}</em> : part))}
        </h1>
        {subtitle && <p class="hero__subtitle">{subtitle}</p>}

        {
          highlights.length > 0 && (
            <ul class="hero__highlights" role="list" aria-label="Destaques">
              {highlights.map((h) => (
                <li>
                  <Icon name={h.icon} size={18} />
                  {h.text}
                </li>
              ))}
            </ul>
          )
        }

        {
          (cta || secondaryCta) && (
            <div class="hero__actions">
              {cta && (
                <Button href={cta.href} variant="on-image" size="lg" icon="arrow-right">
                  {cta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} variant="on-image-outline" size="lg">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }
      </div>

      <p class="hero__unit" aria-hidden="true">{unitLabel}</p>

      {
        clientPreview && !image && (
          <p class="hero__pending" role="note">
            <Icon name="image" size={16} />
            <span>
              <strong>Foto do banner aguardando envio.</strong> Sugestão: vista ampla do loft mostrando o mezanino e os
              ambientes integrados.
            </span>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-3);
    background: var(--white);
  }

  /* Fundo branco da navbar continua até a metade da moldura; abaixo, areia. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 55% 0 0;
    z-index: 0;
    background: var(--color-bg);
  }

  .hero__frame {
    position: relative;
    z-index: 1;
  }

  .hero__stage {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(36rem, 84svh, 50rem);
    padding: 11rem var(--space-3) calc(var(--space-3) + var(--strip-overlap, 0px));
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-lg);
    color: var(--color-on-image);
    background:
      radial-gradient(55% 60% at 88% 12%, rgb(227 162 124 / 0.42), transparent 62%),
      radial-gradient(70% 80% at 0% 100%, var(--sea-600), transparent 62%),
      linear-gradient(160deg, var(--sea-800) 0%, var(--sea-950) 70%);
  }

  @media (min-width: 768px) {
    .hero__stage {
      align-items: center;
      padding: var(--space-8) var(--space-7) calc(var(--space-8) + var(--strip-overlap, 0px));
      border-radius: var(--radius-xl);
    }
  }

  /* ── Foto e véu ─────────────────────────────────────────── */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
  }

  .hero--photo .hero__scrim {
    background: linear-gradient(180deg, rgb(var(--sea-rgb) / 0.1) 0%, rgb(var(--sea-rgb) / 0.55) 100%);
  }

  @media (min-width: 768px) {
    .hero--photo .hero__scrim {
      background: linear-gradient(90deg, rgb(var(--sea-rgb) / 0.55) 0%, rgb(var(--sea-rgb) / 0.12) 60%, transparent 100%);
    }
  }

  /* Textura fina no fundo de marca: linhas de horizonte, discretas. */
  .hero--brand .hero__scrim {
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 28px);
    mask-image: linear-gradient(180deg, transparent 0%, black 45%, transparent 100%);
  }

  /* ── Formas de vidro ────────────────────────────────────── */
  .hero__shapes {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    display: block;
    border: 1px solid var(--glass-border);
    background: var(--glass-light);
    backdrop-filter: blur(8px) saturate(1.2);
    -webkit-backdrop-filter: blur(8px) saturate(1.2);
  }

  .shape--diamond {
    top: 8%;
    right: -10%;
    width: clamp(12rem, 34vw, 30rem);
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
    transform: rotate(45deg);
  }

  .shape--circle {
    top: 4%;
    left: 52%;
    width: clamp(6rem, 13vw, 11rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: rgb(255 255 255 / 0.45);
  }

  .shape--bar {
    bottom: 14%;
    right: 26%;
    width: clamp(3.5rem, 6vw, 5.5rem);
    height: 46%;
    border-radius: var(--radius-pill);
  }

  /* Estrela de quatro pontas — a Estrela-d'Alva, motivo da marca. */
  .shape--star {
    top: 18%;
    right: 15%;
    width: clamp(4rem, 8vw, 7rem);
    aspect-ratio: 1;
    border: 0;
    background: rgb(255 255 255 / 0.3);
    /* Sem desfoque: o Chrome desfoca o retângulo inteiro, ignorando o recorte em estrela. */
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    clip-path: polygon(50% 0%, 59% 41%, 100% 50%, 59% 59%, 50% 100%, 41% 59%, 0% 50%, 41% 41%);
  }

  @media (max-width: 767.98px) {
    .shape--diamond {
      top: -6%;
      right: -22%;
      width: 15rem;
    }
    .shape--circle {
      top: 9%;
      left: 8%;
      width: 5rem;
    }
    .shape--bar {
      display: none;
    }
    .shape--star {
      top: 13%;
      right: 30%;
      width: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .shape--star {
      animation: star-glow 6s ease-in-out infinite alternate;
    }
    .shape--circle {
      animation: drift 9s ease-in-out infinite alternate;
    }
  }

  @keyframes star-glow {
    from {
      opacity: 0.55;
      transform: scale(0.94) rotate(0deg);
    }
    to {
      opacity: 1;
      transform: scale(1.04) rotate(8deg);
    }
  }

  @keyframes drift {
    to {
      transform: translate(10px, 8px);
    }
  }

  /* ── Painel de vidro com o texto ────────────────────────── */
  .hero__panel {
    position: relative;
    display: grid;
    gap: var(--space-4);
    max-width: 41rem;
    padding: var(--space-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 768px) {
    .hero__panel {
      padding: var(--space-7) var(--space-7) var(--space-6);
    }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--terra-300);
  }

  .hero__title {
    margin: 0;
    font-size: var(--text-display);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    color: var(--color-on-image);
  }

  .hero__title :global(em) {
    color: var(--sand-100);
  }

  .hero__subtitle {
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-base);
    color: rgb(255 255 255 / 0.9);
  }

  .hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__highlights li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.08);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
  }

  .hero__highlights :global(.icon) {
    color: var(--terra-300);
  }

  @media (max-width: 479.98px) {
    .hero__highlights li {
      gap: var(--space-1);
      padding: var(--space-1) var(--space-2);
      font-size: var(--text-xs);
    }
    .hero__highlights :global(.icon) {
      width: 15px;
      height: 15px;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (max-width: 479.98px) {
    .hero__actions :global(.btn) {
      flex: 1 1 100%;
      padding-inline: var(--space-4);
    }
  }

  /* Identificação da unidade, gravada no canto como numa placa. */
  .hero__unit {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    background: rgb(var(--sea-rgb) / 0.55);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  @media (max-width: 767.98px) {
    .hero__unit {
      top: var(--space-3);
      right: var(--space-3);
    }
  }

  .hero__pending {
    position: absolute;
    left: 50%;
    top: var(--space-5);
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    width: min(26rem, calc(100% - 2 * var(--space-3)));
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed rgb(255 255 255 / 0.6);
    border-radius: var(--radius-md);
    background: rgb(var(--sea-rgb) / 0.6);
    font-size: var(--text-sm);
    line-height: var(--line-height-snug);
    transform: translateX(-50%);
  }

  @media (max-width: 767.98px) {
    .hero__pending {
      top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__pending {
      left: auto;
      right: var(--space-5);
      top: auto;
      bottom: calc(var(--space-5) + var(--strip-overlap, 0px));
      transform: none;
    }
  }

  .hero__pending :global(.icon) {
    margin-top: 2px;
  }

  /* Entrada discreta dos elementos secundários; o título (LCP) nunca começa invisível. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__panel > :not(.hero__title) {
      animation: hero-in var(--duration-slow) var(--ease-out) both;
    }
    .hero__subtitle {
      animation-delay: 80ms;
    }
    .hero__highlights {
      animation-delay: 160ms;
    }
    .hero__actions {
      animation-delay: 240ms;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
