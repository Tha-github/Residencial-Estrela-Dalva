---
/**
 * Galeria: carrossel horizontal + lightbox acessível.
 *
 * - Ordem narrativa via sortGallery (fachada → social → quartos → externa → detalhes).
 * - Miniaturas recortadas pelo ponto focal (`focus`); o lightbox mostra a foto inteira.
 * - AVIF/WebP + fallback, srcset/sizes, width/height reais (sem CLS), lazy-load.
 * - Carrossel com scroll-snap: rola por toque/trackpad mesmo sem JS; com JS,
 *   setas anterior/próxima (desativadas nas pontas).
 * - Sem JS: cada foto é um link para a imagem ampliada.
 * - Com JS: lightbox em <dialog> com
 *   setas/Home/End/Esc, deslizar no toque, contador anunciado e foco devolvido.
 * - Legenda só aparece quando informada no conteúdo — nada é rotulado automaticamente.
 */
import { getImage, Picture } from 'astro:assets';
import { SECTION_IDS } from '../../lib/content/derive';
import { sortGallery } from '../../lib/content/gallery';
import type { Image } from '../../lib/content/schema';
import { FORMATS, resolveImage, WIDTHS } from '../../lib/images';
import Icon from '../ui/Icon.astro';
import PreviewPlaceholder from '../ui/PreviewPlaceholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  images: Image[];
  title?: string;
  tone?: 'default' | 'alt';
  clientPreview?: boolean;
}

const { images, title = 'Fotos do *loft*', tone, clientPreview = false } = Astro.props;
const ordered = sortGallery(images);
const count = ordered.length;

const items = await Promise.all(
  ordered.map(async (img) => {
    const file = resolveImage(img.src);
    const [avif, webp] = await Promise.all([
      getImage({ src: file, format: 'avif', widths: [...WIDTHS.lightbox] }),
      getImage({ src: file, format: 'webp', widths: [...WIDTHS.lightbox] }),
    ]);
    return {
      img,
      file,
      large: {
        avif: avif.srcSet.attribute,
        webp: webp.srcSet.attribute,
        fallback: webp.src,
        width: file.width,
        height: file.height,
        alt: img.alt,
        caption: img.caption,
      },
    };
  }),
);

const PENDING = [
  'Vista geral do loft (dois níveis)',
  'Fachada ou chegada',
  'Ambientes integrados do piso inferior',
  'Mezanino',
  'Cozinha',
  'Área externa com churrasqueira',
];

const label = (i: number, img: Image) =>
  `Ampliar foto ${i + 1} de ${count}${img.alt ? `: ${img.alt}` : ''}`;
---

<Section id={SECTION_IDS.gallery} eyebrow="Galeria" title={title} width="wide" align="center" tone={tone}>
  {count === 0 && clientPreview ? (
    <div class="carousel" data-carousel>
      <ul class="carousel__track" role="list" aria-label="Espaços reservados para fotos" tabindex="0" data-track>
        {PENDING.map((label) => (
          <li class="carousel__slide">
            <PreviewPlaceholder kind="photo" label={label} />
          </li>
        ))}
      </ul>
      <div class="carousel__nav">
        <button type="button" class="carousel__btn" data-carousel-prev aria-label="Anteriores" disabled>
          <Icon name="chevron-left" size={24} />
        </button>
        <button type="button" class="carousel__btn" data-carousel-next aria-label="Próximos">
          <Icon name="chevron-right" size={24} />
        </button>
      </div>
    </div>
  ) : <div class="gallery-root" data-gallery>
    <div class="carousel" data-carousel>
    <ul class="carousel__track gallery" role="list" aria-label={`Fotos do loft (${count})`} tabindex="0" data-track>
      {
        items.map(({ img, file, large }, i) => (
          <li class="carousel__slide gallery__item">
            <a
              class="gallery__link"
              href={large.fallback}
              data-index={i}
              data-avif={large.avif}
              data-webp={large.webp}
              data-width={large.width}
              data-height={large.height}
              data-alt={large.alt}
              data-caption={large.caption ?? undefined}
              aria-label={label(i, img)}
            >
              <Picture
                src={file}
                alt=""
                formats={[...FORMATS]}
                widths={[...WIDTHS.feature]}
                sizes="(min-width: 1024px) 30rem, (min-width: 768px) 46vw, 85vw"
                loading="lazy"
                decoding="async"
                style={`object-position: ${img.focus}`}
                class="gallery__img"
              />
              {img.caption && <span class="gallery__caption">{img.caption}</span>}
            </a>
          </li>
        ))
      }
    </ul>

    {
      count > 1 && (
        <div class="carousel__nav">
          <button type="button" class="carousel__btn" data-carousel-prev aria-label="Fotos anteriores" disabled>
            <Icon name="chevron-left" size={24} />
          </button>
          <button type="button" class="carousel__btn" data-carousel-next aria-label="Próximas fotos">
            <Icon name="chevron-right" size={24} />
          </button>
        </div>
      )
    }
    </div>

    <dialog class="lightbox" aria-label="Fotos ampliadas" data-lightbox>
      <div class="lightbox__frame">
        <figure class="lightbox__figure">
          <div class="lightbox__stage" data-stage></div>
          <figcaption class="lightbox__caption">
            <span class="lightbox__counter" data-counter aria-live="polite"></span>
            <span data-lb-caption></span>
          </figcaption>
        </figure>
        <button type="button" class="lightbox__btn lightbox__close" data-close>
          <Icon name="close" size={24} />
          <span class="visually-hidden">Fechar</span>
        </button>
        {
          count > 1 && (
            <>
              <button type="button" class="lightbox__btn lightbox__prev" data-prev>
                <Icon name="chevron-left" size={28} />
                <span class="visually-hidden">Foto anterior</span>
              </button>
              <button type="button" class="lightbox__btn lightbox__next" data-next>
                <Icon name="chevron-right" size={28} />
                <span class="visually-hidden">Próxima foto</span>
              </button>
            </>
          )
        }
      </div>
    </dialog>
  </div>}
</Section>

<script>
  // Carrossel: setas rolam um item por vez; desativadas nas pontas.
  // Vale para a galeria e para os quadros pendentes da prévia.
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-track]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prevBtn || !nextBtn) continue;
    const step = () => (track.querySelector<HTMLElement>('.carousel__slide')?.offsetWidth ?? track.clientWidth) + 16;
    const update = () => {
      prevBtn.disabled = track.scrollLeft <= 4;
      nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    prevBtn.addEventListener('click', () => track.scrollBy({ left: -step() }));
    nextBtn.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  interface Slide {
    avif: string;
    webp: string;
    fallback: string;
    width: number;
    height: number;
    alt: string;
    caption: string | null;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const caption = root.querySelector<HTMLElement>('[data-lb-caption]');
    if (!dialog || !stage || !counter || !caption || typeof dialog.showModal !== 'function') continue;

    // Dados de cada foto vêm de atributos data-* dos links (sem JSON/HTML injetado).
    const links = [...root.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const slides: Slide[] = links.map((a) => ({
      avif: a.dataset.avif ?? '',
      webp: a.dataset.webp ?? '',
      fallback: a.href,
      width: Number(a.dataset.width),
      height: Number(a.dataset.height),
      alt: a.dataset.alt ?? '',
      caption: a.dataset.caption ?? null,
    }));
    let current = 0;
    let opener: HTMLElement | null = null;


    const picture = (s: Slide, eager: boolean) => {
      const pic = document.createElement('picture');
      for (const [type, srcset] of [
        ['image/avif', s.avif],
        ['image/webp', s.webp],
      ] as const) {
        const source = document.createElement('source');
        source.type = type;
        source.srcset = srcset;
        source.sizes = '100vw';
        pic.append(source);
      }
      const img = document.createElement('img');
      img.src = s.fallback;
      img.alt = s.alt;
      img.width = s.width;
      img.height = s.height;
      img.decoding = 'async';
      img.loading = eager ? 'eager' : 'lazy';
      pic.append(img);
      return pic;
    };

    const preload = (i: number) => {
      const s = slides[(i + slides.length) % slides.length];
      if (s) picture(s, true); // cria e descarta: o navegador busca e mantém em cache
    };

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      const s = slides[current];
      if (!s) return;
      const pic = picture(s, true);
      const img = pic.querySelector('img')!;
      // Estado de carregamento: indicador até a foto chegar; mensagem se falhar.
      stage.dataset.state = 'loading';
      stage.setAttribute('aria-busy', 'true');
      const done = (state: 'ready' | 'error') => () => {
        if (!stage.contains(img)) return; // usuário já trocou de foto
        stage.dataset.state = state;
        stage.removeAttribute('aria-busy');
      };
      img.addEventListener('load', done('ready'), { once: true });
      img.addEventListener('error', done('error'), { once: true });
      stage.replaceChildren(pic);
      if (img.complete && img.naturalWidth > 0) done('ready')();
      counter.textContent = `Foto ${current + 1} de ${slides.length}`;
      caption.textContent = s.caption ?? '';
      if (slides.length > 1) {
        preload(current + 1);
        preload(current - 1);
      }
    };

    const open = (i: number, from: HTMLElement | null) => {
      opener = from;
      show(i);
      dialog.showModal();
      document.documentElement.classList.add('is-lightbox-open');
      dialog.querySelector<HTMLButtonElement>('[data-close]')?.focus();
    };

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('is-lightbox-open');
      stage.replaceChildren();
      opener?.focus();
    });

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open(Number(link.dataset.index), link);
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

    // Clique fora da foto (fundo escuro ou área vazia ao redor) fecha.
    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target === stage || target.classList.contains('lightbox__frame')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'Home') show(0);
      else if (e.key === 'End') show(slides.length - 1);
      else return;
      e.preventDefault();
    });

    // Deslizar (toque): horizontal > 50px troca a foto.
    let startX: number | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') startX = e.clientX;
    });
    stage.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  /* ── Carrossel ───────────────────────────────────────────── */
  .carousel {
    position: relative;
  }

  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    list-style: none;
  }

  @media (min-width: 768px) {
    .carousel__track {
      grid-auto-columns: calc((100% - var(--space-4)) / 2);
    }
  }

  @media (min-width: 1024px) {
    .carousel__track {
      grid-auto-columns: calc((100% - 2 * var(--space-4)) / 3);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel__track {
      scroll-behavior: smooth;
    }
  }

  .carousel__track:focus-visible {
    outline-offset: 4px;
  }

  .carousel__slide {
    position: relative;
    scroll-snap-align: start;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--sand-200);
  }

  .carousel__slide :global(.preview-placeholder) {
    height: 100%;
    aspect-ratio: auto;
  }

  .carousel__nav {
    display: none;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (scripting: enabled) {
    .carousel__nav {
      display: flex;
    }
  }

  .carousel__btn {
    display: grid;
    place-items: center;
    width: var(--tap-target);
    height: var(--tap-target);
    padding: 0;
    border: var(--border-width) solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-accent);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast);
  }

  .carousel__btn:hover:not(:disabled) {
    background: var(--color-accent-soft);
  }

  .carousel__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .gallery__link {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }

  .gallery__link :global(picture),
  .gallery__link :global(.gallery__img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery__link :global(.gallery__img) {
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .gallery__link:hover :global(.gallery__img) {
    transform: scale(1.03);
  }

  .gallery__link:focus-visible {
    outline-offset: -4px;
    outline-color: var(--white);
    box-shadow: inset 0 0 0 4px var(--color-focus);
  }

  .gallery__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-6) var(--space-4) var(--space-3);
    background: linear-gradient(to top, var(--scrim-strong), var(--scrim-soft));
    color: var(--color-on-image);
    font-size: var(--text-sm);
  }

  /* ── Lightbox ────────────────────────────────────────────── */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(var(--sea-rgb) / 0.95);
    color: var(--white);
  }

  .lightbox::backdrop {
    background: rgb(var(--sea-rgb) / 0.95);
  }

  :global(html.is-lightbox-open) {
    overflow: hidden;
  }

  .lightbox__frame {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: calc(var(--tap-target) + var(--space-4)) var(--space-3) var(--space-4);
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-3);
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .lightbox__stage {
    position: relative;
    display: grid;
    min-height: 0;
    touch-action: pan-y;
  }

  .lightbox__stage :global(picture) {
    display: contents;
  }

  /* Foto inteira, sem recorte; a caixa ocupa o palco desde o início (sem salto). */
  .lightbox__stage :global(img) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  /* Carregando: indicador discreto no centro. */
  .lightbox__stage[data-state='loading']::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 3px solid rgb(255 255 255 / 0.25);
    border-top-color: var(--white);
    border-radius: 50%;
    animation: lightbox-spin 0.8s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__stage[data-state='loading']::after {
      animation: none;
      border-color: rgb(255 255 255 / 0.6);
    }
  }

  @keyframes lightbox-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lightbox__stage[data-state='loading'] :global(img) {
    opacity: 0;
  }

  .lightbox__stage[data-state='error']::after {
    content: 'Não foi possível carregar esta foto.';
    position: absolute;
    inset: 50% 0 auto;
    text-align: center;
    font-size: var(--text-sm);
  }

  .lightbox__stage[data-state='error'] :global(img) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox__stage[data-state='ready'] :global(img) {
      animation: lightbox-in var(--duration-base) var(--ease-out);
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }

  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-4);
    min-height: 1.5em;
    font-size: var(--text-sm);
    text-align: center;
    color: rgb(255 255 255 / 0.85);
  }

  .lightbox__counter {
    font-variant-numeric: tabular-nums;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.12);
    color: var(--white);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .lightbox__btn:focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  .lightbox__close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: var(--space-2);
  }

  .lightbox__next {
    right: var(--space-2);
  }

  /* Mobile: setas embaixo, longe da foto e do polegar que desliza. */
  @media (max-width: 767.98px) {
    .lightbox__frame {
      padding-bottom: calc(48px + var(--space-6));
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: var(--space-4);
      transform: none;
    }
    .lightbox__prev {
      left: calc(50% - 56px);
    }
    .lightbox__next {
      right: calc(50% - 56px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__link:hover :global(.gallery__img) {
      transform: none;
    }
  }
</style>
