---
/**
 * Faixa de informações rápidas, sobreposta à base do banner: identificação
 * da unidade, capacidade e horários. Só itens com dado confirmado.
 */
import { formatTime } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
  content: Residencial;
}

const { content } = Astro.props;
const { property, practical: p } = content;
const facts: Array<{ icon: IconName; label: string; value: string }> = [
  { icon: 'home', label: property.type, value: property.unit },
];
if (p.maxGuests) facts.push({ icon: 'users', label: 'Capacidade', value: `Até ${p.maxGuests} hóspedes` });
if (p.checkIn) facts.push({ icon: 'log-in', label: 'Check-in', value: `A partir das ${formatTime(p.checkIn)}` });
if (p.checkOut) facts.push({ icon: 'log-out', label: 'Check-out', value: `Até as ${formatTime(p.checkOut)}` });
---

<div class="quick container" role="region" aria-label="Informações rápidas da hospedagem">
  <ul class="quick__list" role="list">
    {
      facts.map((f) => (
        <li class="quick__item">
          <span class="quick__icon">
            <Icon name={f.icon} size={22} />
          </span>
          <div>
            <p class="quick__label">{f.label}</p>
            <p class="quick__text">
              <span class="quick__value">{f.value}</span>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .quick {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--strip-overlap));
  }

  .quick__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 1024px) {
    .quick__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .quick__item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
  }

  @media (min-width: 768px) {
    .quick__item {
      padding: var(--space-5) var(--space-5);
    }
  }

  /* Divisórias finas entre os itens */
  .quick__item + .quick__item {
    border-left: var(--border-width) solid var(--color-border);
  }

  @media (max-width: 1023.98px) {
    .quick__item:nth-child(odd) {
      border-left: 0;
    }
    .quick__item:nth-child(n + 3) {
      border-top: var(--border-width) solid var(--color-border);
    }
  }

  @media (max-width: 399.98px) {
    .quick__list {
      grid-template-columns: 1fr;
    }
    .quick__item + .quick__item {
      border-left: 0;
      border-top: var(--border-width) solid var(--color-border);
    }
  }

  .quick__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .quick__label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .quick__text {
    display: grid;
    margin: 0;
  }

  .quick__value {
    font-family: var(--font-display-stack);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    color: var(--color-heading);
  }

</style>
