---
/**
 * Acomodação e capacidade: onde cada pessoa dorme.
 * "Corte" estilizado do loft — telhado, nível superior (mezanino) e piso
 * inferior — com as camas de cada nível. O conteúdo é texto/lista real
 * (lido por leitores de tela na ordem de cima para baixo); o desenho é só moldura.
 * Deixa explícito que é um loft com mezanino, não quartos separados.
 */
import { numberWord, SECTION_IDS } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Icon, { type IconName } from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  content: Residencial;
  tone: 'default' | 'alt';
}

const { content, tone } = Astro.props;
const { sleeping, practical, property } = content;
const loft = property.type.toLowerCase();
const bedIcon: Record<string, IconName> = { casal: 'bed-double', solteiro: 'bed-single', 'sofa-cama': 'sofa' };
const guests = practical.maxGuests;
---

<Section
  id={SECTION_IDS.sleeping}
  eyebrow="Acomodação"
  title={`Onde cada um *vai dormir*`}
  intro={`Um ${loft} com mezanino: os ambientes são distribuídos em dois níveis, sem quartos separados.`}
  tone={tone}
>
  <div class="sleep">
    {
      guests && (
        <div class="capacity reveal">
          <p class="capacity__label">Capacidade</p>
          <p class="capacity__value">
            <span class="numeral capacity__number">{guests}</span>
            <span class="capacity__unit">
              {guests === 1 ? 'hóspede' : 'hóspedes'}
              <br />
              no máximo
            </span>
          </p>
          <p class="capacity__people" aria-hidden="true">
            {Array.from({ length: Math.min(guests, 8) }, () => (
              <span class="person" />
            ))}
          </p>
          <p class="capacity__text">
            Acomoda até {numberWord(guests)} {guests === 1 ? 'pessoa' : 'pessoas'}, entre o mezanino e o piso inferior.
          </p>
        </div>
      )
    }

    <div class="house reveal">
      <svg class="house__roof" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M2 58 L200 4 L398 58" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"></path>
      </svg>
      <ol class="levels" role="list">
        {
          sleeping.map((lvl, i) => (
            <li class:list={['level', { 'level--upper': i === 0 && sleeping.length > 1 }]}>
              <p class="level__name">
                <Icon name="levels" size={16} />
                <span>
                  {lvl.level}
                  {lvl.detail && <strong> · {lvl.detail}</strong>}
                </span>
              </p>
              <ul class="beds" role="list">
                {lvl.beds.map((bed) => (
                  <li class="bed">
                    <span class="bed__icon">
                      <Icon name={bedIcon[bed.type] ?? 'bed-single'} size={30} />
                    </span>
                    <span class="bed__label">{bed.label}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Section>

<style>
  .sleep {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .sleep {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--space-9);
    }
  }

  /* ── Capacidade ─────────────────────────────────────────── */
  .capacity {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .capacity p {
    margin: 0;
  }

  .capacity__label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .capacity__value {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .capacity__number {
    font-size: clamp(5rem, 3rem + 9vw, 9rem);
    color: var(--color-title);
  }

  .capacity__unit {
    font-family: var(--font-display-stack);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.1;
    color: var(--color-heading);
  }

  .capacity__people {
    display: flex;
    gap: var(--space-2);
  }

  /* Pessoa estilizada: cabeça + ombros, só com CSS */
  .person {
    position: relative;
    width: 1.5rem;
    height: 2rem;
  }

  .person::before,
  .person::after {
    content: '';
    position: absolute;
    left: 50%;
    background: var(--color-highlight);
    transform: translateX(-50%);
  }

  .person::before {
    top: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }

  .person::after {
    bottom: 0;
    width: 1.4rem;
    height: 1.05rem;
    border-radius: 0.7rem 0.7rem 0.2rem 0.2rem;
  }

  .capacity__text {
    max-width: 32ch;
    color: var(--color-text-muted);
  }

  /* ── Corte do loft ──────────────────────────────────────── */
  .house {
    position: relative;
    color: var(--color-accent);
  }

  .house__roof {
    display: block;
    width: 100%;
    height: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-border-strong);
  }

  .levels {
    margin: 0;
    padding: 0 var(--space-3) var(--space-3);
    list-style: none;
    border: 2px solid var(--color-border-strong);
    border-top: 0;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 768px) {
    .levels {
      padding: 0 var(--space-5) var(--space-5);
    }
  }

  .level {
    padding: var(--space-5) var(--space-3);
  }

  /* Nível superior: a laje do mezanino é a linha forte abaixo dele. */
  .level--upper {
    position: relative;
    margin-inline-start: clamp(0rem, 8vw, 4rem);
    border-bottom: 3px solid var(--color-accent);
    background: linear-gradient(180deg, transparent, var(--color-accent-soft));
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .level--upper + .level {
    padding-top: var(--space-6);
  }

  .level__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .level__name strong {
    color: var(--color-heading);
  }

  .beds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bed {
    display: flex;
    flex: 1 1 13rem;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .bed__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .bed__label {
    font-family: var(--font-display-stack);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    color: var(--color-heading);
  }
</style>
