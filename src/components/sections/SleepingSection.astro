---
/**
 * Acomodação e capacidade: onde cada pessoa dorme.
 * Um box por cama (lado a lado, centralizados), cada um indicando o nível do
 * loft em que fica. Abaixo, a capacidade em bonequinhos + uma frase curta.
 * Deixa explícito que é um loft com mezanino, não quartos separados.
 */
import { numberWord, SECTION_IDS } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Icon, { type IconName } from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  content: Residencial;
  tone: 'default' | 'alt';
}

const { content, tone } = Astro.props;
const { sleeping, practical, property } = content;
const loft = property.type.toLowerCase();
const bedIcon: Record<string, IconName> = { casal: 'bed-double', solteiro: 'bed-single', 'sofa-cama': 'sofa' };
const guests = practical.maxGuests;

// Uma lista única de camas, cada uma com o nível onde fica (de cima para baixo).
const beds = sleeping.flatMap((lvl) =>
  lvl.beds.map((bed) => ({ ...bed, where: lvl.detail ?? lvl.level })),
);
---

<Section
  align="center"
  id={SECTION_IDS.sleeping}
  eyebrow="Acomodação"
  title={`Onde cada um *vai dormir*`}
  intro={`Um ${loft} com mezanino: os ambientes são distribuídos em dois níveis, sem quartos separados.`}
  tone={tone}
>
  <ul class="beds" role="list">
    {
      beds.map((bed) => (
        <li class="bed reveal">
          <span class="bed__icon">
            <Icon name={bedIcon[bed.type] ?? 'bed-single'} size={34} />
          </span>
          <span class="bed__label">{bed.label}</span>
          <span class="bed__where">
            <Icon name="levels" size={14} />
            {bed.where}
          </span>
        </li>
      ))
    }
  </ul>

  {
    guests && (
      <div class="capacity reveal">
        <p class="capacity__people" aria-hidden="true">
          {Array.from({ length: Math.min(guests, 8) }, () => (
            <span class="person" />
          ))}
        </p>
        <p class="capacity__text">
          Acomoda até {numberWord(guests)} {guests === 1 ? 'pessoa' : 'pessoas'}, entre o mezanino e o piso inferior.
        </p>
      </div>
    )
  }
</Section>

<style>
  /* ── Camas: boxes lado a lado, centralizados ────────────── */
  .beds {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bed {
    display: grid;
    flex: 0 1 16rem;
    align-content: start;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  /* Celular: um box por linha, ocupando a largura. */
  @media (max-width: 599.98px) {
    .bed {
      flex-basis: 100%;
    }
  }

  .bed__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .bed__label {
    font-family: var(--font-display-stack);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    color: var(--color-title);
  }

  .bed__where {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  /* ── Capacidade: bonequinhos + frase ────────────────────── */
  .capacity {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    text-align: center;
  }

  .capacity p {
    margin: 0;
  }

  .capacity__people {
    display: flex;
    gap: var(--space-2);
  }

  /* Pessoa estilizada: cabeça + ombros, só com CSS */
  .person {
    position: relative;
    width: 1.5rem;
    height: 2rem;
  }

  .person::before,
  .person::after {
    content: '';
    position: absolute;
    left: 50%;
    background: var(--color-highlight);
    transform: translateX(-50%);
  }

  .person::before {
    top: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }

  .person::after {
    bottom: 0;
    width: 1.4rem;
    height: 1.05rem;
    border-radius: 0.7rem 0.7rem 0.2rem 0.2rem;
  }

  .capacity__text {
    max-width: 36ch;
    color: var(--color-text-muted);
  }
</style>
