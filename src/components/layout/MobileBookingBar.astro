---
/**
 * Barra fixa de reserva no mobile (mantida da prévia do cliente).
 * Só existe quando há link de plataforma. Apenas CSS — some a partir de 1024px.
 * Leva à seção de reservas (não abre plataforma direto: o visitante escolhe).
 */
import { SECTION_IDS } from '../../lib/content/derive';
import Button from '../ui/Button.astro';
---

<div class="booking-bar">
  <Button href={`#${SECTION_IDS.booking}`} icon="arrow-right" class="booking-bar__btn">Consultar disponibilidade</Button>
</div>

<style>
  .booking-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: rgb(250 247 242 / 0.94);
    backdrop-filter: blur(10px);
    border-top: var(--border-width) solid var(--color-border);
  }

  .booking-bar :global(.booking-bar__btn) {
    width: 100%;
  }

  /* Só aparece depois que o hero (que já tem o CTA) sai de vista: evita dois
     botões iguais na primeira tela. Sem suporte a scroll-driven animations ou
     com movimento reduzido, a barra fica sempre visível (comportamento seguro). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .booking-bar {
        animation: booking-bar-in linear both;
        animation-timeline: scroll(root);
        animation-range: 60vh 80vh;
      }
    }
  }

  @keyframes booking-bar-in {
    from {
      transform: translateY(110%);
      visibility: hidden;
    }
    to {
      transform: none;
      visibility: visible;
    }
  }

  /* Espaço para a barra não cobrir o fim do rodapé. */
  :global(body:has(.booking-bar)) {
    padding-bottom: calc(68px + env(safe-area-inset-bottom));
  }

  @media (min-width: 1024px) {
    .booking-bar {
      display: none;
    }
    :global(body:has(.booking-bar)) {
      padding-bottom: 0;
    }
  }
</style>
