---
/** Rodapé: marca, localização, navegação, plataformas e contato — só com dados existentes. */
import type { BookingPlatform, NavItem } from '../../lib/content/derive';
import { formatWhatsapp, instagramHandle, mailtoUrl, whatsappUrl } from '../../lib/content/derive';
import type { Residencial } from '../../lib/content/schema';
import Icon from '../ui/Icon.astro';

interface Props {
  content: Residencial;
  nav: NavItem[];
  platforms: BookingPlatform[];
}

const { content, nav, platforms } = Astro.props;
const { location, contact, property } = content;
const hasContact = Boolean(contact.whatsapp || contact.instagram || contact.email);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide footer__grid">
    <div class="footer__brand">
      <p class="footer__name">
        <Icon name="star" size={14} class="footer__star" />
        {content.name}
      </p>
      <p>
        {property.type} · {property.unit}
        {property.reference && <> · {property.reference}</>}
      </p>
      {location.address && <address>{location.address}</address>}
      <p>{location.neighborhood} · {location.city}, {location.stateCode}</p>
    </div>

    {
      nav.length > 0 && (
        <nav class="footer__col" aria-label="Rodapé">
          <h2 class="footer__heading">Navegação</h2>
          <ul role="list">
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      platforms.length > 0 && (
        <div class="footer__col">
          <h2 class="footer__heading">Reservar</h2>
          <ul role="list">
            {platforms.map((pl) => (
              <li>
                {pl.url ? (
                  <a href={pl.url} target="_blank" rel="noopener noreferrer">
                    {pl.name}
                    <span class="visually-hidden">(abre em nova aba)</span>
                  </a>
                ) : (
                  <span>{pl.name}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      hasContact && (
        <div class="footer__col">
          <h2 class="footer__heading">Contato</h2>
          <ul role="list">
            {contact.whatsapp && (
              <li>
                <a href={whatsappUrl(contact.whatsapp, contact.whatsappMessage)} target="_blank" rel="noopener noreferrer">
                  WhatsApp {formatWhatsapp(contact.whatsapp)}
                  <span class="visually-hidden">(abre em nova aba)</span>
                </a>
              </li>
            )}
            {contact.instagram && (
              <li>
                <a href={contact.instagram} target="_blank" rel="noopener noreferrer">
                  Instagram {instagramHandle(contact.instagram)}
                  <span class="visually-hidden">(abre em nova aba)</span>
                </a>
              </li>
            )}
            {contact.email && (
              <li>
                <a href={mailtoUrl(contact.email, `Hospedagem no ${content.name}`)}>{contact.email}</a>
              </li>
            )}
          </ul>
        </div>
      )
    }
  </div>

  <div class="container container--wide footer__legal">
    <p>© {year} {content.name}.</p>
    {
      platforms.length > 0 && (
        <p>As reservas são concluídas nas plataformas externas indicadas. Este site não processa reservas nem pagamentos.</p>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    background: var(--sea-950);
    color: rgb(255 255 255 / 0.82);
    font-size: var(--text-sm);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--white);
    text-decoration-color: rgb(255 255 255 / 0.4);
  }

  .site-footer a:hover {
    color: var(--white);
    text-decoration-color: currentColor;
  }

  .site-footer :focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    }
  }

  .footer__col a {
    overflow-wrap: anywhere;
  }

  .footer__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-family: var(--font-display-stack);
    font-size: var(--text-xl);
    color: var(--white);
  }

  .site-footer :global(.footer__star) {
    color: var(--terra-300);
  }

  .footer__brand p {
    margin: 0 0 var(--space-1);
  }

  .footer__brand address {
    font-style: normal;
  }

  .footer__heading {
    margin-bottom: var(--space-2);
    font-family: var(--font-sans-stack);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.82);
  }

  .footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__legal {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid rgb(255 255 255 / 0.16);
    font-size: var(--text-xs);
  }

  .footer__legal p {
    margin: 0;
  }
</style>
