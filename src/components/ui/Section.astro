---
/**
 * Seção padrão: ritmo vertical, cabeçalho (sobretítulo + título + introdução) e conteúdo.
 * O título é obrigatório: cada seção pública precisa de um heading para navegação assistiva.
 * `*trecho*` no título vira ênfase em itálico (texto puro; nunca HTML), como no Ametista.
 */
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string | null;
  tone?: 'default' | 'alt' | 'inverse';
  width?: 'content' | 'wide';
  align?: 'start' | 'center';
  class?: string;
}

const { id, title, eyebrow, intro, tone = 'default', width = 'content', align = 'start', class: className } = Astro.props;
const headingId = `${id}-titulo`;
const parts = title.split(/\*(.+?)\*/);
---

<section
  id={id}
  class:list={['section', `section--${tone}`, { 'on-inverse': tone === 'inverse' }, className]}
  aria-labelledby={headingId}
>
  <div class:list={['container', { 'container--wide': width === 'wide' }]}>
    <header class:list={['section__header', `section__header--${align}`, 'reveal']}>
      {
        eyebrow && (
          <p class="eyebrow">
            <Icon name="star" size={10} class="section__star" />
            {eyebrow}
          </p>
        )
      }
      <h2 id={headingId} class="section__title">
        {parts.map((part, i) => (i % 2 === 1 ? <em>{part}</em> : part))}
      </h2>
      {intro && <p class="lead section__intro">{intro}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    --section-bg: var(--color-bg);
    padding-block: var(--section-gap);
  }

  .section--alt {
    --section-bg: var(--color-surface-alt);
    background: var(--section-bg);
  }

  .section--inverse {
    --section-bg: var(--color-inverse-bg);
  }

  .section__header {
    max-width: var(--width-prose);
    margin-bottom: var(--space-7);
  }

  .section__header--center {
    margin-inline: auto;
    text-align: center;
  }

  .section__title {
    margin-bottom: 0;
  }

  .section__intro {
    margin-top: var(--space-4);
  }

  .section__header--center .section__intro {
    margin-inline: auto;
  }

  .section :global(.section__star) {
    color: var(--color-highlight);
  }

  .section--inverse :global(.section__star) {
    color: var(--terra-300);
  }
</style>
