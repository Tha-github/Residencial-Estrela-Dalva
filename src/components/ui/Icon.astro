---
/**
 * Ícones de linha (24×24, traço 1.5, currentColor) — conjunto próprio e enxuto.
 * Decorativos por padrão (aria-hidden). Passe `label` quando o ícone for o
 * único conteúdo de um controle.
 */
const paths = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'chevron-left': '<path d="m15 18-6-6 6-6"/>',
  'chevron-right': '<path d="m9 18 6-6-6-6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  'map-pin':
    '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  waves:
    '<path d="M2 9c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/>',
  message:
    '<path d="M20 12a8 8 0 0 1-11.7 7.1L4 20l1-4.1A8 8 0 1 1 20 12Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".8" fill="currentColor" stroke="none"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="9.5" r="1.5"/><path d="m21 16-5-5-9 9"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  users:
    '<circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M15.5 4.9a3.2 3.2 0 0 1 0 6.2M17.5 14.3c2.1.6 3.5 2.6 3.5 5.2"/>',
  'bed-double':
    '<path d="M3 18.5V8.5M21 18.5v-4.5a2 2 0 0 0-2-2H3M3 16h18"/><rect x="5" y="9" width="5" height="3" rx="1"/><rect x="12" y="9" width="5" height="3" rx="1"/>',
  'bed-single':
    '<path d="M5 18.5V8.5M19 18.5v-4.5a2 2 0 0 0-2-2H5M5 16h14"/><rect x="7" y="9" width="5" height="3" rx="1"/>',
  sofa:
    '<path d="M5 11V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/><path d="M3 13a2 2 0 0 1 4 0v1h10v-1a2 2 0 0 1 4 0v4H3v-4Z"/><path d="M5 17v2M19 17v2"/>',
  stairs: '<path d="M3 20h5v-4.5h4.5V11H17V6.5h4"/><path d="M3 20h18"/>',
  levels:
    '<path d="m12 3 9 4.5-9 4.5-9-4.5L12 3Z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  pot: '<path d="M4 10h16v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-5Z"/><path d="M2 10h20M9 6.5c0-1 .8-1.5 1.5-1.5h3c.7 0 1.5.5 1.5 1.5V10H9V6.5Z"/>',
  snowflake:
    '<path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5"/><path d="m9.5 4 2.5 2 2.5-2M9.5 20l2.5-2 2.5 2"/>',
  fan: '<circle cx="12" cy="12" r="1.6"/><path d="M12 10.4c-1.5-2.6-1-6.4 1.6-6.4 2.4 0 2.6 3.4-1.6 6.4ZM13.4 12.8c3 0 6 2.3 4.7 4.5-1.2 2.1-4.2.6-4.7-4.5ZM10.6 12.8c-1.5 2.6-5 4.1-6.3 1.9-1.2-2.1 1.6-4 6.3-1.9Z"/><path d="M12 13.6V21M9 21h6"/>',
  flame:
