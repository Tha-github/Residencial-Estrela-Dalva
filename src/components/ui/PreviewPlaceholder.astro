---
import Icon from './Icon.astro';

interface Props {
  label: string;
  kind?: 'field' | 'photo';
  shape?: 'card' | 'wide' | 'inline';
}

const { label, kind = 'field', shape = 'card' } = Astro.props;
---

<div class:list={['preview-placeholder', `preview-placeholder--${kind}`, `preview-placeholder--${shape}`]} role="note">
  <Icon name={kind === 'photo' ? 'image' : 'star'} size={kind === 'photo' ? 24 : 18} />
  <span class="preview-placeholder__label">{label}</span>
  <span class="preview-placeholder__status">Aguardando envio ou confirmação</span>
</div>

<style>
  .preview-placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    min-height: 9rem;
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.62);
    color: var(--color-accent);
    text-align: center;
  }

  .preview-placeholder--photo {
    aspect-ratio: 4 / 3;
    min-height: 0;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.55), transparent 60%),
      repeating-linear-gradient(135deg, rgb(26 72 83 / 0.035) 0 12px, transparent 12px 24px),
      var(--sand-100);
  }

  .preview-placeholder--wide {
    aspect-ratio: 16 / 7;
  }

  .preview-placeholder--inline {
    display: flex;
    justify-content: flex-start;
    justify-items: initial;
    min-height: var(--tap-target);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    text-align: left;
  }

  .preview-placeholder__label {
    font-weight: var(--font-weight-bold);
    color: var(--color-heading);
  }

  .preview-placeholder__status {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 479.98px) {
    .preview-placeholder--photo {
      aspect-ratio: 1 / 1;
    }
  }
</style>
