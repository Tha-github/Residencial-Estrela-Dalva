// Worker independente do painel administrativo — Residencial Estrela Dalva.
// Segredos SOMENTE via `wrangler secret put`:
//   PROVISIONING_KEY      código gerado por `npm run admin:setup-secrets`
//   CONFIG_ENCRYPTION_KEY chave AES-256 gerada pelo mesmo comando
//   SESSION_SECRET        chave HMAC gerada pelo mesmo comando
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "estrela-dalva-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "vars": {
    "GITHUB_REPO": "Tha-github/Residencial-Estrela-Dalva",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://tha-github.github.io,http://localhost:4321",
    "SESSION_HOURS": "8",
  },
  "d1_databases": [
    {
      "binding": "CONFIG",
      "database_name": "estrela-dalva-admin-config",
    "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
