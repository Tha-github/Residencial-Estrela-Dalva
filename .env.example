# Copie para .env e preencha localmente. NUNCA coloque segredos aqui.
# Variáveis PUBLIC_* vão para o HTML/JS público — não use para nada sigiloso.

# Domínio canônico (obrigatório em produção). Ex.: https://www.seudominio.com.br
PUBLIC_SITE_URL=

# development | preview | production
# Fora de "production" o site é marcado como noindex.
PUBLIC_DEPLOY_ENV=development

# Painel: configurar como secrets/vars no Cloudflare Pages e no build hook.
# Nunca prefixar com PUBLIC_. Veja docs/PAINEL-ADMIN.md.
# ACCESS_TEAM_DOMAIN=seu-time.cloudflareaccess.com
# ACCESS_AUD=
# OWNER_EMAIL=
# DEPLOY_HOOK_URL=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CF_D1_DATABASE=residencial-estrela-dalva-content
# CF_R2_BUCKET=residencial-estrela-dalva-media
# CF_SYNC_CONTENT=1
