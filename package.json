{
  "name": "residencial-estrela-dalva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "node scripts/sync-admin-content.mjs && node scripts/generate-social-card.mjs",
    "postbuild": "node scripts/generate-seo-files.mjs && node scripts/generate-security-headers.mjs",
    "seo:check": "node scripts/check-seo-artifacts.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:placeholders": "node scripts/generate-dev-placeholders.mjs",
    "admin:setup-secrets": "node scripts/generate-admin-secrets.mjs",
    "admin:dev": "npx --yes wrangler@4.164.0 dev --config admin-worker/wrangler.jsonc",
    "admin:deploy": "npx --yes wrangler@4.164.0 deploy --config admin-worker/wrangler.jsonc",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run seo:check"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "astro": "7.4.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
